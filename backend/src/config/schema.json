  },
  "relationships": [
    {
      "from": "sales_order_headers",
      "to": "sales_order_items",
      "type": "HAS_ITEM",
      "condition": "sales_order = sales_order"
    },
    {
      "from": "sales_order_items",
      "to": "sales_order_schedule_lines",
      "type": "HAS_SCHEDULE",
      "condition": "sales_order = sales_order AND sales_order_item = sales_order_item"
    },
    {
      "from": "sales_order_headers",
      "to": "business_partners",
      "type": "ORDERED_BY",
      "condition": "sold_to_party = business_partner"
    },
    {
      "from": "sales_order_items",
      "to": "outbound_delivery_items",
      "type": "DELIVERED_AS",
      "condition": "sales_order = reference_sd_document"
    },
    {
      "from": "outbound_delivery_headers",
      "to": "outbound_delivery_items",
      "type": "HAS_ITEM",
      "condition": "delivery_document = delivery_document"
    },
    {
      "from": "outbound_delivery_items",
      "to": "plants",
      "type": "SHIPPED_FROM",
      "condition": "plant = plant"
    },
    {
      "from": "outbound_delivery_items",
      "to": "billing_document_items",
      "type": "BILLED_AS",
      "condition": "delivery_document = reference_sd_document"
    },
    {
      "from": "billing_document_headers",
      "to": "billing_document_items",
      "type": "HAS_ITEM",
      "condition": "billing_document = billing_document"
    },
    {
      "from": "billing_document_headers",
      "to": "business_partners",
      "type": "BILLED_TO",
      "condition": "sold_to_party = business_partner"
    },
    {
      "from": "billing_document_headers",
      "to": "billing_document_cancellations",
      "type": "CANCELLED_BY",
      "condition": "billing_document = billing_document"
    },
    {
      "from": "billing_document_headers",
      "to": "journal_entry_items_ar",
      "type": "POSTED_TO",
      "condition": "accounting_document = accounting_document"
    },
    {
      "from": "journal_entry_items_ar",
      "to": "business_partners",
      "type": "BELONGS_TO_CUSTOMER",
      "condition": "customer = business_partner"
    },
    {
      "from": "journal_entry_items_ar",
      "to": "payments_ar",
      "type": "CLEARED_BY",
      "condition": "accounting_document = accounting_document"
    },
    {
      "from": "sales_order_items",
      "to": "products",
      "type": "CONTAINS_PRODUCT",
      "condition": "material = product"
    },
    {
      "from": "billing_document_items",
      "to": "products",
      "type": "BILLED_PRODUCT",
      "condition": "material = product"
    },
    {
      "from": "products",
      "to": "product_descriptions",
      "type": "HAS_DESCRIPTION",
      "condition": "product = product"
    },
    {
      "from": "products",
      "to": "product_plants",
      "type": "AVAILABLE_IN",
      "condition": "product = product"
    },
    {
      "from": "product_plants",
      "to": "plants",
      "type": "LOCATED_AT",
      "condition": "plant = plant"
    },
    {
      "from": "products",
      "to": "product_storage_locations",
      "type": "STORED_AT",
      "condition": "product = product"
    },
    {
      "from": "business_partners",
      "to": "business_partner_addresses",
      "type": "HAS_ADDRESS",
      "condition": "business_partner = business_partner"
    },
    {
      "from": "business_partners",
      "to": "customer_company_assignments",
      "type": "ASSIGNED_TO_COMPANY",
      "condition": "customer = customer"
    },
    {
      "from": "business_partners",
      "to": "customer_sales_area_assignments",
      "type": "ASSIGNED_TO_SALES_AREA",
      "condition": "customer = customer"
    }
  ]
}